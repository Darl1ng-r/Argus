DATABASE_URL="postgresql://argus:argus_dev_secret@localhost:5433/argus"
PORT=4000
NODE_ENV=development

# Redis for distributed rate limiting (points to the local docker-compose Redis)
REDIS_URL="redis://localhost:6380"

# Dev-only: Allow X-User-Id/X-User-Name header auth (NEVER true in production)
ALLOW_DEV_AUTH=true

# Clerk (fill in from your Clerk dashboard for real auth)
# CLERK_SECRET_KEY=sk_test_...
# CORS_ORIGINS=http://localhost:5173
