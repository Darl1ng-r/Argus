// This is your Prisma schema file
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String   @id @default(uuid())
  username   String   @unique
  email      String   @unique
  reputation Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at")

  authoredNodes  Node[]  @relation("NodeAuthor")
  authoredEdges  Edge[]  @relation("EdgeAuthor")
  votes          Vote[]
  authoredTopics Topic[] @relation("TopicAuthor")

  @@map("users")
}

model Topic {
  id          String   @id @default(uuid())
  title       String
  rootNodeId  String?  @map("root_node_id")
  authorId    String   @map("author_id")
  forkCount   Int      @default(0) @map("fork_count")
  createdAt   DateTime @default(now()) @map("created_at")

  author   User   @relation("TopicAuthor", fields: [authorId], references: [id])
  rootNode Node?  @relation("TopicRoot", fields: [rootNodeId], references: [id])
  nodes    Node[] @relation("TopicNodes")
  edges    Edge[]

  @@map("topics")
}

model Node {
  id           String   @id @default(uuid())
  topicId      String   @map("topic_id")
  parentId     String?  @map("parent_id")
  authorId     String   @map("author_id")
  content      String
  edgeType     String   @map("edge_type") @default("root") // root|supports|refutes|clarifies|evidence
  posX         Float    @default(0) @map("pos_x")
  posY         Float    @default(0) @map("pos_y")
  supportScore Int      @default(0) @map("support_score")
  contestScore Int      @default(0) @map("contest_score")
  isSteel      Boolean  @default(false) @map("is_steel")
  status       String   @default("ACTIVE")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")

  topic       Topic  @relation("TopicNodes", fields: [topicId], references: [id], onDelete: Cascade)
  author      User   @relation("NodeAuthor", fields: [authorId], references: [id])
  parent      Node?  @relation("NodeChildren", fields: [parentId], references: [id])
  children    Node[] @relation("NodeChildren")
  votes       Vote[]

  // Back-relation for topics that use this node as root
  rootOfTopics Topic[] @relation("TopicRoot")

  @@index([topicId])
  @@index([parentId])
  @@map("nodes")
}

model Edge {
  id         String   @id @default(uuid())
  topicId    String   @map("topic_id")
  fromNodeId String   @map("from_node_id")
  toNodeId   String   @map("to_node_id")
  type       String   // SUPPORTS|REFUTES|CLARIFIES|REQUIRES_EVIDENCE|EQUIVALENT_TO
  authorId   String   @map("author_id")
  createdAt  DateTime @default(now()) @map("created_at")

  topic    Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  author   User  @relation("EdgeAuthor", fields: [authorId], references: [id])

  @@unique([fromNodeId, toNodeId, type])
  @@index([topicId])
  @@map("edges")
}

model Vote {
  id        String   @id @default(uuid())
  nodeId    String   @map("node_id")
  userId    String   @map("user_id")
  voteType  String   @map("vote_type") // SUPPORT|CONTEST
  createdAt DateTime @default(now()) @map("created_at")

  node Node @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@unique([nodeId, userId])
  @@index([nodeId])
  @@map("votes")
}
