DATABASE_URL="postgresql://argus:argus_dev_secret@localhost:5433/argus"
PORT=4000
NODE_ENV=development

# Redis for distributed rate limiting
REDIS_URL="redis://localhost:6380"

# Dev-only: Allow X-User-Id/X-User-Name header auth (NEVER true in production)
ALLOW_DEV_AUTH=true

# Production: Clerk auth (required when ALLOW_DEV_AUTH is false)
# CLERK_SECRET_KEY=sk_live_...

# Allowed CORS origins (comma-separated)
# CORS_ORIGINS=https://argus.yourapp.com

# DB pool tuning (optional, defaults shown)
# DB_POOL_MAX=20

# Database Encryption in Transit (SSL/TLS)
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=true

# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info
