# ============================================================
# Argus API — Environment Variables Reference
# Copy this file to .env and fill in your values.
# ============================================================

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://argus:argus_dev_secret@localhost:5433/argus"

# DB pool settings (optional, defaults shown)
# DB_POOL_MAX=20

# Database Encryption in Transit (SSL/TLS)
# DB_SSL=true               # Enable SSL/TLS for DB connections
# DB_SSL_REJECT_UNAUTHORIZED=true  # Reject self-signed certs in production

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Trust proxy headers (set to number of proxy hops or 'true' behind load balancer)
# TRUST_PROXY=1

# ---------------------------------------------------------------------------
# Redis — Distributed rate limiting, caching, and Pub/Sub for SSE
# ---------------------------------------------------------------------------
REDIS_URL="redis://localhost:6380"

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Dev-only: Allow X-User-Id/X-User-Name header auth (NEVER true in production!)
ALLOW_DEV_AUTH=true

# Production: Clerk auth (required when ALLOW_DEV_AUTH is false)
# CLERK_SECRET_KEY=sk_live_...

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins. Default: localhost Vite dev server.
# CORS_ORIGINS=https://argus.yourapp.com,https://www.argus.yourapp.com

# ---------------------------------------------------------------------------
# Prometheus Metrics Endpoint Security
# ---------------------------------------------------------------------------
# Secret token for GET /metrics — Prometheus scraper must send:
#   Authorization: Bearer <METRICS_TOKEN>
# In production, METRICS_TOKEN MUST be set or /metrics returns 403.
# METRICS_TOKEN=your_strong_random_secret_here

# ---------------------------------------------------------------------------
# AI Features (Gemini)
# ---------------------------------------------------------------------------
# Gemini API key for AI argument analysis (POST /api/topics/:id/ai-analyze).
# If not set, a mock analysis response is returned (safe for dev).
# GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
# Log level: trace | debug | info | warn | error | fatal
# LOG_LEVEL=info

