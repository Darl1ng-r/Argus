{
  "name": "argus-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Argus — Ratio, in the open. Directed argument-mapping platform.",
  "scripts": {
    "dev:api": "npm --prefix apps/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "build:api": "npm --prefix apps/api run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:api && npm run build:web",
    "test": "npm --prefix apps/api run test"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
